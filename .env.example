# ============================================================
# Environment Variables — Kafka Cluster
# ============================================================
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
# ============================================================

# Docker Host IP
# ---------------
# The IP address used by the EXTERNAL Kafka listener.
# Default: 127.0.0.1 (localhost)
# Change this if connecting from a remote machine or VM.
DOCKER_HOST_IP=127.0.0.1
